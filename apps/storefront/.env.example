# One app, three sites. Local dev reads .env.<brand> (`vite dev --mode <brand>`);
# create them with `node scripts/make-env.mjs`. On Oxygen, each storefront injects
# its own store values, and BRAND_KEY plus the secrets below are set per environment.

# house, laroche-posay, or kerastase
BRAND_KEY=

PUBLIC_STORE_DOMAIN=
PUBLIC_STOREFRONT_ID=
PUBLIC_STOREFRONT_API_TOKEN=
PRIVATE_STOREFRONT_API_TOKEN=

# House Storefront API identity. Carts are scoped to this so one bag works on every site.
SHARED_CART_STOREFRONT_ID=
SHARED_CART_PRIVATE_STOREFRONT_API_TOKEN=

# Customer Accounts. Each storefront has its own client ID.
SHOP_ID=
PUBLIC_CUSTOMER_ACCOUNT_API_CLIENT_ID=
PUBLIC_CUSTOMER_ACCOUNT_API_URL=
# Signs this site's session cookie. At least 32 random characters, different per site.
SESSION_SECRET=

# Signs brand-switch and sign-out links between the sites. The SAME value on all three.
HANDOFF_SECRET=

# Deployed origins. Empty uses the local dev addresses.
PUBLIC_HOUSE_URL=
PUBLIC_LA_ROCHE_POSAY_URL=
PUBLIC_KERASTASE_URL=
